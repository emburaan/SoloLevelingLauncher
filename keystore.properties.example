# Copy this file to keystore.properties and fill in your real values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# Create the upload keystore first (run from the project root):
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at that .jks and use the passwords you chose.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
